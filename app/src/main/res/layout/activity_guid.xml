<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.GuidActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layoutDirection="rtl"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="راهنما"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    app:layout_constraintBottom_toBottomOf="@+id/backBtn"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/backBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:background="@drawable/button_background"
                    android:clickable="true"
                    android:contentDescription="@string/app_name"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:padding="12dp"
                    android:tint="@color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_arrow_back"
                    tools:ignore="UseAppTint" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/textView7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="16dp"
                android:text="راهنمای استفاده از اپلیکیشن یادآور دارو "
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

            <TextView
                android:id="@+id/textView9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:justificationMode="inter_word"
                android:text="به اپلیکیشن یادآور دارو خوش آمدید! ما بسیار خوشحالیم که شما به جمع کاربران ما پیوسته‌اید. این راهنما به شما کمک می‌کند تا با ویژگی‌ها و قابلیت‌های اصلی اپلیکیشن آشنا شوید و از تمامی امکانات آن به بهترین نحو بهره‌مند شوید." />

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="150dp"
                android:layout_height="300dp"
                android:layout_marginTop="8dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/image_1" />

            <TextView
                android:id="@+id/textView10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:text="1: تقویم"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                tools:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/textView11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:justificationMode="inter_word"
                android:text="در این بخش شما می توانید تاریخ مورد نظر خور را انتخاب کنید و با زدم بروی علامت + در پایین صفحه درا تاریخ مورد نظر یک هشدار برای یادآوری دارو تنظیم کنید."
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            <TextView
                android:id="@+id/textView12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:text="2: لیست دارو ها"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

            <TextView
                android:id="@+id/textView13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:justificationMode="inter_word"
                android:text="در این بخش لیست تمام دارو هایی که  در آن تاریخ انتخاب شده نمایش داده می شود."
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            <TextView
                android:id="@+id/textView14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:text="3: افزودن یادآور"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

            <TextView
                android:id="@+id/textView15"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:text="با فشردن علامت + وارد صفحه افزودن یادآور دارو می شود."
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            <ImageView
                android:id="@+id/imageView3"
                android:layout_width="200dp"
                android:layout_height="450dp"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/image_2" />

            <TextView
                android:id="@+id/textView16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:justificationMode="inter_word"
                android:text="در این صفحه شما می تونید یک هشدار برای یادآوری زمان مصرف دارو تنظیم کنید.\n
دارو: در این بخش می توانید نام دارو و یک توضیح برای نحوه مصرف دارو تنظیم کنید.\n
زمان یادآوری: در این بخش باید بازه تکراری هشدار را تنظیم کنید به عنوان مثال هر 8 ساعت\n
توجه داشته باشید زمان یادآوری نمی تواند کمتر از 1 ساعت یعنی 00:59 تنظیم شود.\n
در این بخش تاریخ شروع را که در صفحه قبل انتخاب کرده اید نمایش می دهدو همچنین میتوانید ساعت شروع هشدارها را تنظیم نمایید.\n
در بخش زنگ هشدار شما می توانید برای هشداری که تنظیم کرده اید اهنگ هر دارو را متفاوت تنظیم کنید.\n
در قسمت زمان بدی شما می توانید یک دارو را به صورت ادامه دار(به مدت 60 روز)تنظیک کنید با با استفاده از گزینه مدت محدود در بازه 1 تا 15 روز مدت زمان اجرای هشدار را تنظیم نمایید."
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

            <TextView
                android:id="@+id/textView19"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginRight="8dp"
                android:text="4: تنظیمات"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="150dp"
                android:layout_height="300dp"
                android:layout_marginTop="8dp"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/image_3" />

            <TextView
                android:id="@+id/textView20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:justificationMode="inter_word"
                android:text="مهم ترین بخش ها در این صفحه تنظیم تعویق است که شما میتوانید یک عدد بین 1 تا 15 دقیقه برای تعویق هشدار تنظیم کنید.\n
بخش مهم دیگه ارسال پیامک است که می توانید با فعال کردن گزینه ارسال پیام و وارد کردن شماره زمان ارسال هر هشدار یک پیامک به شماره ای که وارد کرده اید ارسال می شود."
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>